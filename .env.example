# Conexión pooled (PgBouncer) — usada en runtime por PrismaClient vía @prisma/adapter-neon
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/lyfter_badge_app?sslmode=require"

# Conexión directa (sin pooling) — usada por Prisma Migrate / CLI, ver prisma.config.ts
DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/lyfter_badge_app?sslmode=require"

# Secreto para sesión JWT
SESSION_SECRET=xxxxxxxxxxxxxxxxxxxx

# Secreto para el token rotativo de QR (antifraude) — distinto de SESSION_SECRET a propósito
QR_TOKEN_SECRET=xxxxxxxxxxxxxxxxxxxx